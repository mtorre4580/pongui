# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# File names carry a content hash: cache them for good
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Recorded clips and screenshots keep their names between releases
/landing/*
  Cache-Control: public, max-age=86400

# The service worker must be checked on every visit, or updates never arrive
/sw.js
  Cache-Control: no-cache
