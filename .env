# Public URL of the site (canonical link, Open Graph, JSON-LD, robots.txt, sitemap.xml and the
# links of shared levels in the native apps). Ends with "/".
VITE_SITE_URL=https://pongui.com/

# Umami Cloud website id (anonymous statistics). Empty: nothing is loaded. Set in the deploy
# workflow from the repository variable UMAMI_WEBSITE_ID.
VITE_UMAMI_ID=
