{
  "name": "pongui",
  "private": true,
  "version": "0.2.0",
  "description": "Pongui: a bouncing-ball puzzle game for desktop, tablet and phone. Installable PWA that works offline.",
  "keywords": [
    "game",
    "puzzle",
    "platformer",
    "bouncing-ball",
    "pwa",
    "phaser",
    "typescript",
    "vite",
    "html5-game"
  ],
  "homepage": "https://pongui.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtorre4580/boinky.git"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "validate:levels": "tsx scripts/validate-levels.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "check:fairness": "tsx scripts/check-fairness.ts",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "media": "tsx scripts/capture-media.ts",
    "icons": "node scripts/make-icons.mjs",
    "prepare": "husky",
    "build:native": "tsc --noEmit && vite build --mode native && cap sync",
    "ios": "cap open ios",
    "android": "cap open android",
    "native:assets": "capacitor-assets generate --ios --android --iconBackgroundColor \"#0d1024\" --splashBackgroundColor \"#0d1024\""
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/fredoka": "5.3.0",
    "phaser": "3.90.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "7.3.8",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.12"
  }
}
